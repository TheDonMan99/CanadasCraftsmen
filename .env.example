# Copy to .env.local and fill in. Never commit real values.
# Supabase → Connect → "Transaction pooler" (port 6543)
DATABASE_URL=
# Supabase → Project Settings → API Keys. SUPABASE_URL is https://<project>.supabase.co (nothing after .co)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Resend → API Keys. Without it, emails are logged as skipped.
RESEND_API_KEY=
# Who gets new-order alerts (defaults to Settings → Emails → notify email)
NOTIFY_EMAIL=donovanarntson@gmail.com
ADMIN_EMAIL=donovanarntson@gmail.com
# The site's public address, for links in emails, e.g. https://yoursite.vercel.app
SITE_URL=
# Cloudflare → Turnstile → your widget. Without them the spam check is skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
